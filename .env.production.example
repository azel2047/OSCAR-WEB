# =============================================================================
# OSCAR 3.0 — Production Environment Template
# PENTING: Salin file ini ke .env.production dan isi semua nilai yang kosong!
# File .env.production TIDAK boleh di-commit ke Git!
# =============================================================================

APP_NAME="OSCAR 3.0"
APP_ENV=production
APP_KEY=                          # Generate: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-domain.com  # Ganti dengan domain production
FRONTEND_URL=https://your-domain.com

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ── Database (Supabase PostgreSQL via PgBouncer) ───────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=<supabase-project>.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-supabase-password>
DB_SSLMODE=require

# ── Queue & Session (via Database) ─────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# ── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_BUCKET_BERKAS=berkas-pendaftaran
SUPABASE_BUCKET_GALERI=galeri-season

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourmailprovider.com
MAIL_PORT=587
MAIL_USERNAME=your-email@yourdomain.com
MAIL_PASSWORD=<your-smtp-password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@oscar.id"
MAIL_FROM_NAME="OSCAR 3.0"

# ── Admin Credentials (ubah segera setelah deploy!) ──────────────────────────
ADMIN_PASSWORD=<strong-password-here>

# ── Port mapping (Docker) ─────────────────────────────────────────────────────
APP_PORT=80

# ── OPcache (aktif otomatis via php.ini) ──────────────────────────────────────
# Tidak perlu diubah; sudah dikonfigurasi di docker/php/php.ini

# ── Redis (opsional — aktifkan jika Redis service dinyalakan) ─────────────────
# REDIS_CLIENT=phpredis
# REDIS_HOST=redis
# REDIS_PASSWORD=your_redis_password
# REDIS_PORT=6379
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
