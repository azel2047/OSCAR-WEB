APP_NAME="OSCAR 3.0"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

# POSTGRESQL / SUPABASE DATABASE CONNECTION
DB_CONNECTION=pgsql
DB_HOST=<supabase-project>.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-password>
DB_SSLMODE=require

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# SUPABASE STORAGE CONFIG
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_BUCKET_BERKAS=berkas-pendaftaran
SUPABASE_BUCKET_GALERI=galeri-season

# EMAIL CONFIG
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@oscar.id"
MAIL_FROM_NAME="OSCAR 3.0"

# Admin credential default (ubah setelah setup!)
ADMIN_PASSWORD=Admin@oscar3
